pkgname=meo-icons
pkgver=0.3.0
pkgrel=4
pkgdesc="Meo Material system icons and per-application Pixel icon studio"
arch=('any')
license=('Apache-2.0')
depends=('breeze-icons' 'hicolor-icon-theme' 'python-pillow')
source=()
sha256sums=()

package() {
  install -d "${pkgdir}/usr/share/icons"
  for icon_theme in MeoSymbols MeoSymbolsDark; do
    cp -a "${startdir}/../../../themes/icons/${icon_theme}" "${pkgdir}/usr/share/icons/${icon_theme}"
  done
  install -Dm755 "${startdir}/../../../tools/icons/app_icon_studio.py" \
    "${pkgdir}/usr/bin/meo-app-icon-studio"
}
