# Source-checkout convenience recipe. Distribution recipes are owned by meo-repo.
pkgname=meo-desktop
pkgver=0.4.0
pkgrel=12
pkgdesc="Meo Desktop independent Plasma session"
arch=('x86_64')
url='https://github.com/QwQdoge/meo-kde'
license=('GPL-3.0-or-later' 'GPL-2.0-or-later' 'MIT' 'Apache-2.0' 'OFL-1.1')
depends=('meoui-qml>=1.0.4beta2' 'meo-icons>=0.4.0' 'plasma-desktop' 'plasma-workspace'
         'plasma-nm' 'plasma-pa' 'powerdevil' 'bluedevil' 'systemsettings' 'dolphin'
         'konsole' 'breeze' 'polkit-kde-agent' 'networkmanager-qt' 'bluez-qt'
         'solid' 'pulseaudio-qt' 'kguiaddons' 'kwindowsystem' 'kconfig' 'kirigami'
         'libplasma' 'layer-shell-qt' 'kdecoration' 'kcmutils' 'kcolorscheme'
         'fcitx5' 'fcitx5-gtk' 'fcitx5-qt' 'dbus-broker-units')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-base' 'qt6-declarative' 'polkit-qt6')
optdepends=('fcitx5-configtool: upstream input method configuration'
            'ibus: optional alternative input method'
            'kwin-effect-rounded-corners: optional window rounding effect')
options=('!debug')
provides=('meo-kde-runtime=0.4.0' 'meo-desktop-session=1')
conflicts=('meo-kde-runtime')
replaces=('meo-kde-runtime')
source=()
sha256sums=()

build() {
  local workspace="${startdir}/../.."
  cmake -S "${workspace}/native" -B "${srcdir}/native-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DMEOUI_SOURCE_DIR="${MEO_UI_ROOT:-${workspace}/../meo-ui}" \
    -DMEO_BUILD_STANDALONE_DOCK=OFF
  cmake --build "${srcdir}/native-build" --parallel
}

package() {
  local workspace="${startdir}/../.."
  "${workspace}/tools/session/package-meo-desktop" "${workspace}" "${srcdir}/native-build" "${pkgdir}"
}
