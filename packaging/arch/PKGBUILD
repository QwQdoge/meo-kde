pkgname=meo-desktop
pkgver=0.3.1beta1
pkgrel=1
pkgdesc="MeoArch KDE Plasma desktop defaults and Meo Qt application style"
arch=('x86_64')
url="https://github.com/QwQdoge"
license=('GPL-3.0-or-later')
depends=('meoui-qml>=1.0.2beta1' 'plasma-desktop' 'plasma-workspace' 'plasma-nm' 'plasma-pa' 'powerdevil'
         'bluedevil' 'systemsettings' 'dolphin' 'konsole' 'sddm' 'breeze'
         'networkmanager-qt' 'bluez-qt' 'solid' 'pulseaudio-qt' 'meo-icons>=0.3.1beta1-1'
         'kwin-effect-rounded-corners')
makedepends=('cmake' 'extra-cmake-modules' 'qt6-base' 'qt6-declarative')
optdepends=('omnistore-bin: MeoArch application discovery and package management'
            'fcitx5: Fcitx 5 candidate UI for compatible input engines'
            'fcitx5-configtool: graphical configuration for Fcitx 5 options'
            'fcitx5-gtk: Fcitx 5 GTK and XWayland input-method module'
            'fcitx5-qt: Fcitx 5 Qt and XWayland input-method module'
            'ibus: IBus candidate panel bridge; enable with meo-input-method')
source=()
sha256sums=()

build() {
  local workspace="${startdir}/../.."
  cmake -S "${workspace}/native" -B "${srcdir}/native-build" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMEOUI_SOURCE_DIR="${workspace}/../meo-ui"
  cmake --build "${srcdir}/native-build" --parallel
}

package() {
  local workspace="${startdir}/../.."
  install -d "${pkgdir}/usr/share/plasma/look-and-feel"
  cp -a "${workspace}/themes/look-and-feel/org.meo.desktop" \
    "${pkgdir}/usr/share/plasma/look-and-feel/"
  install -d "${pkgdir}/usr/share/plasma/desktoptheme"
  for desktop_theme in MeoLight MeoDark; do
    cp -a "${workspace}/themes/desktoptheme/${desktop_theme}" \
      "${pkgdir}/usr/share/plasma/desktoptheme/"
  done
  install -d "${pkgdir}/usr/share/plasma/plasmoids"
  cp -a "${workspace}/plasmoids/org.meo.topbar" \
    "${workspace}/plasmoids/org.meo.timecenter" \
    "${pkgdir}/usr/share/plasma/plasmoids/"
  install -d "${pkgdir}/usr/share/color-schemes"
  install -m644 "${workspace}"/themes/color-schemes/*.colors \
    "${pkgdir}/usr/share/color-schemes/"
  install -Dm644 "${workspace}/assets/wallpapers/installer_background.png" \
    "${pkgdir}/usr/share/wallpapers/MeoArch/installer_background.png"
  install -Dm644 "${workspace}/assets/icons/meoarch-logo.svg" \
    "${pkgdir}/usr/share/pixmaps/meoarch-logo.svg"
  install -Dm644 "${workspace}/assets/icons/meoarch-logo.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/meoarch-logo.svg"
  install -Dm755 "${workspace}/tools/theme/apply-meo-mode.sh" \
    "${pkgdir}/usr/bin/meo-theme-mode"
  install -Dm755 "${workspace}/tools/theme/apply-meo-desktop.sh" \
    "${pkgdir}/usr/bin/meo-desktop-apply"
  install -Dm644 "${workspace}/defaults/kwin/kwinrc" \
    "${pkgdir}/usr/share/meo-desktop/defaults/kwinrc"
  install -Dm755 "${workspace}/tools/shell/apply-meo-panel-layout.sh" \
    "${pkgdir}/usr/bin/meo-desktop-layout"
  install -Dm644 "${workspace}/defaults/plasma/meo-shellrc" \
    "${pkgdir}/etc/xdg/meo-shellrc"
  install -Dm644 "${workspace}/defaults/sddm/meoarch.conf" \
    "${pkgdir}/etc/sddm.conf.d/20-meoarch.conf"
  install -Dm644 "${workspace}/defaults/sddm/theme.conf.user" \
    "${pkgdir}/usr/share/sddm/themes/breeze/theme.conf.user"
  install -Dm644 "${workspace}/defaults/system/os-release" \
    "${pkgdir}/etc/os-release"
  install -Dm644 "${workspace}/defaults/kde/kdeglobals" \
    "${pkgdir}/etc/xdg/kdeglobals"
  install -Dm644 "${workspace}/defaults/kwin/kwinrc" \
    "${pkgdir}/etc/xdg/kwinrc"
  install -Dm644 "${workspace}/defaults/plasma/plasmarc" \
    "${pkgdir}/etc/xdg/plasmarc"
  install -Dm644 "${workspace}/defaults/plasma/plasma-welcomerc" \
    "${pkgdir}/etc/xdg/plasma-welcomerc"
  install -Dm644 "${workspace}/defaults/environment/90-meo-applications.conf" \
    "${pkgdir}/etc/environment.d/90-meo-applications.conf"
  install -Dm644 "${workspace}/defaults/input-method/fcitx5/conf/classicui.conf" \
    "${pkgdir}/etc/xdg/fcitx5/conf/classicui.conf"
  install -d "${pkgdir}/usr/share/fcitx5/themes"
  cp -a "${workspace}/themes/input-method/fcitx5/MeoInputMethod-Light" \
    "${workspace}/themes/input-method/fcitx5/MeoInputMethod-Dark" \
    "${pkgdir}/usr/share/fcitx5/themes/"
  install -Dm755 "${workspace}/tools/input-method/meo-input-method.sh" \
    "${pkgdir}/usr/bin/meo-input-method"
  install -Dm644 "${workspace}/themes/input-method/ibus/gtk.css.in" \
    "${pkgdir}/usr/share/meo-desktop/input-method/ibus/gtk.css.in"
  install -Dm644 "${workspace}/themes/input-method/ibus/index.theme" \
    "${pkgdir}/usr/share/meo-desktop/input-method/ibus/index.theme"

  install -Dm644 "${workspace}/defaults/systemd/meo-dynamic-colors.path" \
    "${pkgdir}/usr/lib/systemd/user/meo-dynamic-colors.path"
  install -Dm644 "${workspace}/defaults/systemd/meo-dynamic-colors.service" \
    "${pkgdir}/usr/lib/systemd/user/meo-dynamic-colors.service"
  sed -i 's|%h/.local/bin/|/usr/bin/|g' \
    "${pkgdir}/usr/lib/systemd/user/meo-dynamic-colors.service"
  install -d "${pkgdir}/usr/lib/systemd/user/default.target.wants"
  ln -s ../meo-dynamic-colors.path \
    "${pkgdir}/usr/lib/systemd/user/default.target.wants/meo-dynamic-colors.path"

  install -d "${pkgdir}/usr/lib/qt6/qml/MeoKDE"
  cp -a "${workspace}/qml/MeoKDE/." "${pkgdir}/usr/lib/qt6/qml/MeoKDE/"
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/native-build"
  install -d "${pkgdir}/usr/share/fonts/meo"
  install -m644 "${workspace}"/assets/fonts/*.ttf "${pkgdir}/usr/share/fonts/meo/"
  install -Dm644 "${workspace}/defaults/fonts/50-meo-fonts.conf" \
    "${pkgdir}/etc/fonts/conf.avail/50-meo-fonts.conf"
  install -d "${pkgdir}/etc/fonts/conf.d"
  ln -s ../conf.avail/50-meo-fonts.conf "${pkgdir}/etc/fonts/conf.d/50-meo-fonts.conf"
}
