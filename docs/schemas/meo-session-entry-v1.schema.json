{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meoarch.org/schemas/session-entry/v1",
  "title": "Meo session entry configuration",
  "description": "Validated, presentation-only preferences for one Meo session-lock or login surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "appearance",
    "modules",
    "privacy",
    "layout",
    "motion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": ["lockscreen", "login"]
    },
    "appearance": {
      "$ref": "#/$defs/appearance"
    },
    "modules": {
      "$ref": "#/$defs/modules"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "motion": {
      "$ref": "#/$defs/motion"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {"const": "login"}
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "appearance": {
            "properties": {
              "wallpaper": {
                "properties": {
                  "source": {"enum": ["system-default", "managed-asset"]}
                }
              },
              "wallpaperMode": {"const": "managed"}
            }
          },
          "modules": {
            "properties": {
              "media": {"const": false},
              "weather": {"const": false},
              "audio": {"const": false},
              "weatherCity": {"const": ""}
            }
          },
          "privacy": {
            "properties": {
              "notificationVisibility": {"const": "hidden"},
              "showAlbumArtwork": {"const": false},
              "weatherLocation": {"const": "hidden"}
            }
          },
          "layout": {
            "properties": {
              "displayOverrides": {
                "items": {
                  "properties": {
                    "wallpaper": {
                      "properties": {
                        "source": {"enum": ["system-default", "managed-asset"]}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "wallpaper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "assetId", "fillMode"],
      "properties": {
        "source": {
          "enum": ["system-default", "current-user", "managed-asset"]
        },
        "assetId": {
          "type": "string",
          "maxLength": 256,
          "description": "Symbolic asset identifier. It is empty only for system-default; consumers must additionally reject traversal-like segments, URLs, and raw filesystem paths."
        },
        "fillMode": {
          "enum": ["cover", "contain", "stretch", "center"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {"const": "system-default"}
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "assetId": {"const": ""}
            }
          },
          "else": {
            "properties": {
              "assetId": {
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
              }
            }
          }
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clockStyle", "showDate", "backgroundTreatment", "wallpaperMode", "wallpaper"],
      "properties": {
        "clockStyle": {
          "enum": ["large", "compact"]
        },
        "showDate": {
          "type": "boolean"
        },
        "backgroundTreatment": {
          "enum": ["dim", "blur", "solid"]
        },
        "wallpaperMode": {
          "description": "follow-desktop resolves only a wallpaper already supplied by the trusted logged-in desktop/session-lock integration; it never accepts a path or URL from this document.",
          "enum": ["follow-desktop", "managed"],
          "default": "follow-desktop"
        },
        "wallpaper": {
          "$ref": "#/$defs/wallpaper"
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media", "weather", "audio", "weatherCity"],
      "properties": {
        "media": {
          "type": "boolean",
          "default": true
        },
        "weather": {
          "type": "boolean",
          "default": true
        },
        "audio": {
          "description": "Output volume and mute only; output-device and input-device selection are excluded.",
          "type": "boolean",
          "default": true
        },
        "weatherCity": {
          "description": "City-granularity preference consumed only by the separate per-user cache refresher, never by the login surface.",
          "type": "string",
          "maxLength": 96,
          "default": ""
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notificationVisibility", "showAlbumArtwork", "weatherLocation"],
      "properties": {
        "notificationVisibility": {
          "enum": ["hidden", "count", "app-name", "full-content"],
          "default": "count"
        },
        "showAlbumArtwork": {
          "type": "boolean",
          "default": false
        },
        "weatherLocation": {
          "enum": ["hidden", "city", "precise"],
          "default": "city"
        }
      }
    },
    "displayOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputKey", "wallpaper"],
      "properties": {
        "outputKey": {
          "description": "Opaque stable output identity, never a raw EDID or coordinate.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "wallpaper": {
          "$ref": "#/$defs/wallpaper"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeAuthenticationScreen", "displayOverrides"],
      "properties": {
        "activeAuthenticationScreen": {
          "enum": ["auto", "fixed-primary", "follow-interaction"]
        },
        "displayOverrides": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/displayOverride"
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduceMotion"],
      "properties": {
        "reduceMotion": {
          "enum": ["system", "always", "never"]
        }
      }
    }
  }
}
