[Desktop Entry]
Name=Meo System Authentication
Name[zh_CN]=Meo 系统认证
Comment=Authenticate requests to change protected system settings
Comment[zh_CN]=认证需要修改受保护系统设置的请求
Exec=/usr/lib/meo-polkit-agent
Icon=dialog-password
Terminal=false
Type=Application
OnlyShowIn=KDE;
X-KDE-StartupNotify=false
X-KDE-autostart-phase=0
NoDisplay=true
X-DBUS-StartupType=Unique
X-systemd-skip=true
