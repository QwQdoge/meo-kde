import QtQuick
import QtQuick.Controls
import MeoUI 1.0
import org.kde.kcmutils as KCM
import org.kde.kirigami as Kirigami
KCM.SimpleKCM { property alias cfg_density: density.currentValue; property alias cfg_textScalePercent: scale.value; property alias cfg_surfaceStyle: surface.currentValue; property alias cfg_surfaceOpacityPercent: opacity.value; property alias cfg_motionProfile: motion.currentValue; property alias cfg_showUnreadBadge: badge.checked; property alias cfg_showJobs: jobs.checked; property alias cfg_showNotificationHistory: history.checked; property alias cfg_notificationView: notificationView.currentValue; property alias cfg_notificationPreview: preview.currentValue; Kirigami.FormLayout { MeoExposedDropdown { id: density; Kirigami.FormData.label: i18n("Density:"); textRole: "text"; valueRole: "value"; model: [{text:i18n("Compact"),value:"compact"},{text:i18n("Comfortable"),value:"comfortable"}] } MeoSpinBox { id: scale; from: 85; to: 125; stepSize: 5; Kirigami.FormData.label: i18n("Text size:") } MeoExposedDropdown { id: notificationView; Kirigami.FormData.label: i18n("Notification view:"); textRole: "text"; valueRole: "value"; model: [{text:i18n("Cards"),value:"cards"},{text:i18n("Compact list"),value:"compact"}] } MeoExposedDropdown { id: preview; Kirigami.FormData.label: i18n("Preview:"); textRole: "text"; valueRole: "value"; model: [{text:i18n("Full"),value:"full"},{text:i18n("Summary"),value:"summary"},{text:i18n("Hidden"),value:"hidden"}] } MeoCheckbox { id: badge; text: i18n("Show unread badge") } MeoCheckbox { id: jobs; text: i18n("Show background tasks") } MeoCheckbox { id: history; text: i18n("Show notification history") } MeoExposedDropdown { id: surface; Kirigami.FormData.label: i18n("Surface:"); textRole:"text"; valueRole:"value"; model:[{text:i18n("Follow theme"),value:"theme"},{text:i18n("Flat"),value:"flat"},{text:i18n("Tonal"),value:"tonal"},{text:i18n("Translucent"),value:"translucent"}] } MeoSpinBox { id: opacity; from:70; to:100; stepSize:5; Kirigami.FormData.label:i18n("Surface opacity:") } MeoExposedDropdown { id: motion; Kirigami.FormData.label:i18n("Motion:"); textRole:"text"; valueRole:"value"; model:[{text:i18n("Calm"),value:"calm"},{text:i18n("Pixel"),value:"pixel"},{text:i18n("Playful"),value:"playful"}] } } }
