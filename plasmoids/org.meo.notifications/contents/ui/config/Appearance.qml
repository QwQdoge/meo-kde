import QtQuick
import QtQuick.Controls
import org.kde.kcmutils as KCM
import org.kde.kirigami as Kirigami
KCM.SimpleKCM { property alias cfg_density: density.currentValue; property alias cfg_textScalePercent: scale.value; property alias cfg_surfaceStyle: surface.currentValue; property alias cfg_surfaceOpacityPercent: opacity.value; property alias cfg_motionProfile: motion.currentValue; property alias cfg_showUnreadBadge: badge.checked; property alias cfg_showJobs: jobs.checked; Kirigami.FormLayout { ComboBox { id: density; Kirigami.FormData.label: i18n("Density:"); textRole: "text"; valueRole: "value"; model: [{text:i18n("Compact"),value:"compact"},{text:i18n("Comfortable"),value:"comfortable"}] } SpinBox { id: scale; from: 85; to: 125; stepSize: 5; Kirigami.FormData.label: i18n("Text size:") } ComboBox { id: surface; Kirigami.FormData.label: i18n("Surface:"); textRole:"text"; valueRole:"value"; model:[{text:i18n("Follow theme"),value:"theme"},{text:i18n("Flat"),value:"flat"},{text:i18n("Tonal"),value:"tonal"},{text:i18n("Translucent"),value:"translucent"}] } SpinBox { id: opacity; from:70; to:100; stepSize:5; Kirigami.FormData.label:i18n("Surface opacity:") } ComboBox { id: motion; Kirigami.FormData.label:i18n("Motion:"); textRole:"text"; valueRole:"value"; model:[{text:i18n("Calm"),value:"calm"},{text:i18n("Pixel"),value:"pixel"},{text:i18n("Playful"),value:"playful"}] } CheckBox { id: badge; text: i18n("Show unread badge") } CheckBox { id: jobs; text: i18n("Show background tasks") } } }
