[Unit]
Description=Generate Meo KDE Material 3 colors from the active KDE accent
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/meo-dynamic-colors --follow-meo --apply
ExecStartPost=%h/.local/bin/meo-input-method --sync --quiet

[Install]
WantedBy=graphical-session.target
