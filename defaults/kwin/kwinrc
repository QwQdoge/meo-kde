[Effect-overview]
BorderActivate=9

[Plugins]
overviewEnabled=true
org.meo.windowcornersEnabled=false
kwin4_effect_shapecornersEnabled=true
scaleEnabled=true
glideEnabled=false
squashEnabled=true
magiclampEnabled=false

[Effect-scale]
Duration=180
InScale=0.94
OutScale=0.98

[TabBox]
LayoutName=thumbnail_grid

[Windows]
FocusPolicy=ClickToFocus

[Wayland]
# Fcitx 5 is the Meo-managed default input-method client on Plasma Wayland.
# KWin owns its launch so native text-input protocols work correctly. This is
# only an XDG default: a user's kwinrc can override or disable it later.
InputMethod=/usr/share/applications/org.fcitx.Fcitx5.desktop

[org.kde.kdecoration2]
library=org.meo.decoration
theme=Meo Chrome Frame

[org.meo.decoration]
TitleBarHeight=32
CornerRadius=16
ButtonDiameter=24
ButtonHitSize=32
ButtonSpacing=2
ButtonRightMargin=6
ShowButtonBackground=true
ShadowIntensity=0.18
ShadowRadius=28
ShadowOffsetY=6
HoverInDuration=100
HoverOutDuration=80
FocusTransitionDuration=180
AlignTitleCenter=true
EnableAccentTint=false
EnableCompanionEffect=false
SquareMaximized=true

[Round-Corners]
Size=16
InactiveCornerRadius=16
UseSquircleShape=false
UseNativeDecorationShadows=true
OutlineThickness=0
InactiveOutlineThickness=0
DisableRoundTile=true
DisableRoundMaximize=true
DisableRoundFullScreen=true
